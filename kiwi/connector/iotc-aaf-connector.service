# The connector installed in @DIR@ (install.sh), at boot: the language model on the Ara240, port 3000 of this board
# alone. Installed by install-service.sh. The port opens only once the model is loaded, minutes after the start.
# Logs: journalctl -u iotc-aaf-connector
[Unit]
Description=eIQ AAF Connector: the language model on the Ara240, port 3000
After=ara2-device.target

[Service]
Type=simple
WorkingDirectory=@DIR@
# The Ara240's proxy is started when udev finds the card, not in order with this at boot: wait for it.
ExecStartPre=/bin/sh -c 'until systemctl is-active --quiet ara2-proxy.service; do sleep 5; done'
TimeoutStartSec=infinity
ExecStart=@DIR@/venv/bin/connector --config config/server_config.json --host 127.0.0.1 --port 3000
# While the model loads, the server does not get to its SIGTERM handler: SIGKILL after 10 s.
TimeoutStopSec=10
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
