 logger = get_logger(__name__)
 
 
+def _for_template(messages) -> list[dict]:
+    """The conversation as the chat template takes it: a tool call's arguments as an object.
+
+    OpenAI's format, as a client sends the conversation back, carries them as a JSON string, and Qwen's template
+    writes them with `| tojson`, which quotes that string and escapes its quotes. The model then writes its next
+    call the same way, and the tool parser, which drops every backslash, cannot read it back: the call comes back
+    as text. Only after a call with arguments; an empty "{}" has nothing to escape.
+    """
+    conversation = [msg.model_dump(exclude_none=True) for msg in messages]
+    for message in conversation:
+        for tool_call in message.get("tool_calls") or []:
+            function = tool_call.get("function", {})
+            if isinstance(function.get("arguments"), str):
+                try:
+                    function["arguments"] = json.loads(function["arguments"])
+                except ValueError:
+                    pass
+    return conversation
+
+
