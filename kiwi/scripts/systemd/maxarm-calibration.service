# The calibration app at boot, its pages on port 8080. Installed by ../install-service.sh. The arm it connects
# itself, and again while it is not there: each try resets the arm's board, which homes the arm.
[Unit]
Description=MaxArm calibration app (web pages on port 8080)
Wants=network-online.target
After=network-online.target
# Each holds the arm and the camera: starting one stops the other.
Conflicts=maxarm-app.service

[Service]
Type=simple
WorkingDirectory=@KIWI@
ExecStart=@KIWI@/calibrate.sh
# As Ctrl-C stops it: the arm held where it is, the port closed.
KillSignal=SIGINT
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
