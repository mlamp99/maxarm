# The /IOTCONNECT app at boot. Installed by ../install-service.sh. It needs config/iotcDeviceConfig.json and a
# calibration; without either it stops, and systemd tries again every 30 s. The arm it connects itself, and again
# while it is not there: each try resets the arm's board, which homes the arm (src/app/app.py).
[Unit]
Description=MaxArm /IOTCONNECT tiles app
Wants=network-online.target
After=network-online.target
# Each holds the arm and the camera: starting one stops the other.
Conflicts=maxarm-calibration.service

[Service]
Type=simple
WorkingDirectory=@KIWI@
ExecStart=@KIWI@/run.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
