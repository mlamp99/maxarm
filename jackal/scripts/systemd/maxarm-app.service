# The /IOTCONNECT app at boot. Installed by ../install-service.sh. It needs config/iotcDeviceConfig.json and a
# calibration; without either it stops, and systemd tries again every 30 s.
# Starting it connects the arm, which resets the arm's board and homes the arm.
[Unit]
Description=MaxArm /IOTCONNECT tiles app
Wants=network-online.target
After=network-online.target
# Each holds the arm and the camera: starting one stops the other.
Conflicts=maxarm-calibration.service

[Service]
Type=simple
WorkingDirectory=@JACKAL@
Environment=PYTHONUNBUFFERED=1
ExecStartPre=@JACKAL@/scripts/wait-for-rig.sh
ExecStart=@JACKAL@/.venv/bin/python src/main.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
